# ==========================================================================
# さくらのAI Engine ラボ環境 - 環境変数サンプル
# 使い方: このファイルを .env にコピーして値を書き換えてください
#   cp .env.example .env
# コントロールパネルの「アカウントトークン」から発行したトークンを
# SAKURA_API_KEY に設定します（<UUID>:<シークレット> の形式のまま）。
# ==========================================================================

# 必須: さくらのAI Engine アカウントトークン
# 教材のcurl例に合わせて AI_ENGINE_TOKEN を優先的に読み込みます（SAKURA_API_KEYでも可）
AI_ENGINE_TOKEN=<UUID>:<シークレット>
SAKURA_API_KEY=<UUID>:<シークレット>

# 通常は変更不要（さくらのAI Engine のAPIベースURL）
SAKURA_API_BASE=https://api.ai.sakura.ad.jp/v1

# 各ハンズオンで使うデフォルトモデル（コントロールパネルの「利用可能なモデル」で要確認）
SAKURA_CHAT_MODEL=gpt-oss-120b
SAKURA_MULTIMODAL_MODEL=preview/Phi-4-multimodal-instruct
SAKURA_EMBEDDING_MODEL=multilingual-e5-large
SAKURA_TRANSCRIBE_MODEL=whisper-large-v3-turbo
SAKURA_TTS_MODEL=zundamon

# --- Open WebUI（docker-compose使用時のみ）---
# Open WebUI から さくらのAI Engine を OpenAI互換エンドポイントとして利用する
OPENAI_API_BASE_URL=https://api.ai.sakura.ad.jp/v1
OPENAI_API_KEY=<UUID>:<シークレット>

# --- AppRunデプロイ時のみ ---
# AppRunはリクエスト待受ポートを PORT 環境変数で渡してきます（予約変数のため自分では設定しないこと）
